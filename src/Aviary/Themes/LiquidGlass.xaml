<!--
    AVIARY — LIQUID GLASS THEME
    Safari 26 / macOS Tahoe. Chrome that floats above the page rather than sitting on it.

    NOT MERGED IN PHASE 1. It exists now so the token contract is proven from the start:
    every key declared in Classic.xaml is declared here too, with the same name and the
    same type. Phase 3 swaps which of the two App.xaml merges, and no control changes.

    HONEST LIMITS — read before Phase 3. Three things this theme needs have no direct
    WinUI 3 equivalent, and pretending otherwise would waste a phase:

      1. backdrop-filter blur on an arbitrary element. WinUI has no per-element backdrop
         blur. DesktopAcrylicBackdrop and MicaBackdrop apply to a WINDOW, not a Border.
         The real route is a Composition backdrop brush
         (Compositor.CreateBackdropBrush) chained through GaussianBlurEffect and
         SaturationEffect from Win2D (Microsoft.Graphics.Win2D), painted into a
         SpriteVisual behind the toolbar. That is a NuGet dependency and needs asking
         about first.
      2. The 1px gradient ring that is bright at two poles and near-invisible at the
         flanks. Achievable with a Border whose BorderBrush is a LinearGradientBrush —
         it will be close, but WinUI strokes the whole border with one gradient rather
         than masking a padded box, so the corners behave slightly differently.
      3. Saturation boost on the backdrop. Win2D again, same dependency.

    Until those land, this dictionary approximates the material with flat translucent
    fills over the window's own Mica. That reads as "tinted panel", not "glass" — a
    known, deliberate shortfall, not an oversight.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- rgba(255,255,255,0.44). High alpha kills the premise: above about 0.60 you
                 stop seeing content move underneath and it stops being glass. -->
            <SolidColorBrush x:Key="AvChromeBrush"          Color="#70FFFFFF" />
            <SolidColorBrush x:Key="AvPageBrush"            Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AvHairlineBrush"        Color="#12000000" />

            <SolidColorBrush x:Key="AvLabelBrush"           Color="#D9000000" />
            <SolidColorBrush x:Key="AvLabelSecondaryBrush"  Color="#993C3C43" />
            <SolidColorBrush x:Key="AvLabelTertiaryBrush"   Color="#4D3C3C43" />
            <SolidColorBrush x:Key="AvIconBrush"            Color="#B8000000" />

            <SolidColorBrush x:Key="AvHoverBrush"           Color="#24787880" />
            <SolidColorBrush x:Key="AvPressBrush"           Color="#38787880" />
            <SolidColorBrush x:Key="AvSelectedBrush"        Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AvTabActiveBrush"      Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AvTabHoverBrush"       Color="#1A787880" />

            <!-- The address well is DARKER than the glass around it. Recessed, not raised:
                 a raised control inside a raised capsule looks like a button on a button. -->
            <SolidColorBrush x:Key="AvFieldBrush"           Color="#1F787880" />
            <SolidColorBrush x:Key="AvFieldBorderBrush"     Color="#0D000000" />
            <SolidColorBrush x:Key="AvFieldFocusBrush"      Color="#A8FFFFFF" />

            <SolidColorBrush x:Key="AvAccentBrush"          Color="#FF007AFF" />
            <SolidColorBrush x:Key="AvSeparatorBrush"       Color="#1A000000" />

            <!-- The specular pair. Light on top, dark on the bottom lip. -->
            <SolidColorBrush x:Key="AvEdgeTopBrush"         Color="#C7FFFFFF" />
            <SolidColorBrush x:Key="AvEdgeBottomBrush"      Color="#17000000" />

            <!-- SITE IDENTITY. The monogram is the fallback when a site has no icon of
                 its own; the hues live here rather than in code so High Contrast can turn
                 them into a bordered ButtonFace box instead of a coloured square that
                 disappears. A REAL favicon is never tinted or rounded. -->
            <SolidColorBrush x:Key="AvFaviconPlaceholderBrush" Color="#1A787880" />
            <SolidColorBrush x:Key="AvMonogramInkBrush"        Color="#E6000000" />
            <SolidColorBrush x:Key="AvMonogramBorderBrush"     Color="#14000000" />
            <SolidColorBrush x:Key="AvMonogram1Brush"          Color="#33007AFF" />
            <SolidColorBrush x:Key="AvMonogram2Brush"          Color="#33FF9500" />
            <SolidColorBrush x:Key="AvMonogram3Brush"          Color="#3334C759" />
            <SolidColorBrush x:Key="AvMonogram4Brush"          Color="#33FF2D55" />
            <SolidColorBrush x:Key="AvMonogram5Brush"          Color="#33AF52DE" />
            <SolidColorBrush x:Key="AvMonogram6Brush"          Color="#3330B0C7" />
            <SolidColorBrush x:Key="AvMonogram7Brush"          Color="#335856D6" />
            <SolidColorBrush x:Key="AvMonogram8Brush"          Color="#33A2845E" />

            <!-- THE SIDEBAR. One surface carrying Tabs, Bookmarks, Reading List and
                 History, exactly as Safari switches its sidebar between panes. -->
            <SolidColorBrush x:Key="AvSidebarBrush"                  Color="#59FFFFFF" />
            <SolidColorBrush x:Key="AvSidebarBorderBrush"            Color="#0F000000" />
            <SolidColorBrush x:Key="AvSidebarHeaderBrush"            Color="#993C3C43" />
            <SolidColorBrush x:Key="AvSidebarRowHoverBrush"          Color="#1A787880" />
            <SolidColorBrush x:Key="AvSidebarRowSelectedBrush"       Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AvSidebarRowEmphasisBrush"       Color="#FF007AFF" />
            <SolidColorBrush x:Key="AvSidebarRowEmphasisLabelBrush"  Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AvSidebarGripBrush"              Color="#00000000" />
            <SolidColorBrush x:Key="AvSidebarGripHoverBrush"         Color="#26007AFF" />
            <SolidColorBrush x:Key="AvSegmentBrush"                  Color="#1F787880" />
            <SolidColorBrush x:Key="AvSegmentSelectedBrush"          Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AvUnreadDotBrush"                Color="#FF007AFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Dark glass is a different recipe, not an inversion: higher fill alpha, and
                 a cool bias (blue channel above red) because a neutral #1C1C1E looks dead. -->
            <SolidColorBrush x:Key="AvChromeBrush"          Color="#851E1F24" />
            <SolidColorBrush x:Key="AvPageBrush"            Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="AvHairlineBrush"        Color="#14FFFFFF" />

            <SolidColorBrush x:Key="AvLabelBrush"           Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="AvLabelSecondaryBrush"  Color="#99EBEBF5" />
            <SolidColorBrush x:Key="AvLabelTertiaryBrush"   Color="#4DEBEBF5" />
            <!-- Icons stop at 0.80, not 0.92: full-white strokes halate against bright
                 blurred content behind the glass. -->
            <SolidColorBrush x:Key="AvIconBrush"            Color="#CCFFFFFF" />

            <SolidColorBrush x:Key="AvHoverBrush"           Color="#21EBEBF5" />
            <SolidColorBrush x:Key="AvPressBrush"           Color="#33EBEBF5" />
            <SolidColorBrush x:Key="AvSelectedBrush"        Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AvTabActiveBrush"      Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AvTabHoverBrush"       Color="#17EBEBF5" />

            <SolidColorBrush x:Key="AvFieldBrush"           Color="#3D767680" />
            <SolidColorBrush x:Key="AvFieldBorderBrush"     Color="#38000000" />
            <SolidColorBrush x:Key="AvFieldFocusBrush"      Color="#1CFFFFFF" />

            <SolidColorBrush x:Key="AvAccentBrush"          Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AvSeparatorBrush"       Color="#1CFFFFFF" />

            <!-- The top specular stays WHITE in dark mode. There is never a black top edge. -->
            <SolidColorBrush x:Key="AvEdgeTopBrush"         Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AvEdgeBottomBrush"      Color="#80000000" />

            <!-- SITE IDENTITY. The monogram is the fallback when a site has no icon of
                 its own; the hues live here rather than in code so High Contrast can turn
                 them into a bordered ButtonFace box instead of a coloured square that
                 disappears. A REAL favicon is never tinted or rounded. -->
            <SolidColorBrush x:Key="AvFaviconPlaceholderBrush" Color="#21EBEBF5" />
            <SolidColorBrush x:Key="AvMonogramInkBrush"        Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="AvMonogramBorderBrush"     Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AvMonogram1Brush"          Color="#3D0A84FF" />
            <SolidColorBrush x:Key="AvMonogram2Brush"          Color="#3DFF9F0A" />
            <SolidColorBrush x:Key="AvMonogram3Brush"          Color="#3D30D158" />
            <SolidColorBrush x:Key="AvMonogram4Brush"          Color="#3DFF375F" />
            <SolidColorBrush x:Key="AvMonogram5Brush"          Color="#3DBF5AF2" />
            <SolidColorBrush x:Key="AvMonogram6Brush"          Color="#3D40C8E0" />
            <SolidColorBrush x:Key="AvMonogram7Brush"          Color="#3D5E5CE6" />
            <SolidColorBrush x:Key="AvMonogram8Brush"          Color="#3DAC8E68" />

            <!-- THE SIDEBAR. One surface carrying Tabs, Bookmarks, Reading List and
                 History, exactly as Safari switches its sidebar between panes. -->
            <SolidColorBrush x:Key="AvSidebarBrush"                  Color="#6B1E1F24" />
            <SolidColorBrush x:Key="AvSidebarBorderBrush"            Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AvSidebarHeaderBrush"            Color="#99EBEBF5" />
            <SolidColorBrush x:Key="AvSidebarRowHoverBrush"          Color="#17EBEBF5" />
            <SolidColorBrush x:Key="AvSidebarRowSelectedBrush"       Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AvSidebarRowEmphasisBrush"       Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AvSidebarRowEmphasisLabelBrush"  Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AvSidebarGripBrush"              Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AvSidebarGripHoverBrush"         Color="#260A84FF" />
            <SolidColorBrush x:Key="AvSegmentBrush"                  Color="#21EBEBF5" />
            <SolidColorBrush x:Key="AvSegmentSelectedBrush"          Color="#3DEBEBF5" />
            <SolidColorBrush x:Key="AvUnreadDotBrush"                Color="#FF0A84FF" />
        </ResourceDictionary>

        <!-- Required, and deliberately NOT glassy. Contrast themes exist to remove
             ambiguity; translucency is the opposite of that, so under high contrast this
             theme renders as flat, opaque system colours, exactly like Classic. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AvChromeBrush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvPageBrush"            Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AvHairlineBrush"        Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="AvLabelBrush"           Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvLabelSecondaryBrush"  Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvLabelTertiaryBrush"   Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AvIconBrush"            Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="AvHoverBrush"           Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvPressBrush"           Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSelectedBrush"        Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvTabActiveBrush"      Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvTabHoverBrush"       Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="AvFieldBrush"           Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AvFieldBorderBrush"     Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvFieldFocusBrush"      Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="AvAccentBrush"          Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSeparatorBrush"       Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="AvEdgeTopBrush"         Color="Transparent" />
            <SolidColorBrush x:Key="AvEdgeBottomBrush"      Color="Transparent" />

            <!-- SITE IDENTITY. The monogram is the fallback when a site has no icon of
                 its own; the hues live here rather than in code so High Contrast can turn
                 them into a bordered ButtonFace box instead of a coloured square that
                 disappears. A REAL favicon is never tinted or rounded. -->
            <SolidColorBrush x:Key="AvFaviconPlaceholderBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AvMonogramInkBrush"        Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvMonogramBorderBrush"     Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvMonogram1Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram2Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram3Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram4Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram5Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram6Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram7Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvMonogram8Brush"          Color="{ThemeResource SystemColorButtonFaceColor}" />

            <!-- THE SIDEBAR. One surface carrying Tabs, Bookmarks, Reading List and
                 History, exactly as Safari switches its sidebar between panes. -->
            <SolidColorBrush x:Key="AvSidebarBrush"                  Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvSidebarBorderBrush"            Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvSidebarHeaderBrush"            Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvSidebarRowHoverBrush"          Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSidebarRowSelectedBrush"       Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSidebarRowEmphasisBrush"       Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSidebarRowEmphasisLabelBrush"  Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AvSidebarGripBrush"              Color="Transparent" />
            <SolidColorBrush x:Key="AvSidebarGripHoverBrush"         Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSegmentBrush"                  Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AvSegmentSelectedBrush"          Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvUnreadDotBrush"                Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- GEOMETRY. Radius is exactly half the height on every capsule — a stadium. 16px or
         20px on a 48px bar reads as Chrome instantly. -->
    <x:Double x:Key="AvToolbarHeight">48</x:Double>
    <x:Double x:Key="AvFieldHeight">36</x:Double>
    <x:Double x:Key="AvButtonSize">36</x:Double>
    <x:Double x:Key="AvIconSize">18</x:Double>
    <x:Double x:Key="AvTabHeight">32</x:Double>
    <x:Double x:Key="AvCaptionButtonWidth">46</x:Double>
    <x:Double x:Key="AvGlyphStrokeThickness">1.6</x:Double>

    <CornerRadius x:Key="AvFieldCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="AvButtonCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="AvTabCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="AvChromeCornerRadius">24</CornerRadius>

    <Thickness x:Key="AvToolbarPadding">6</Thickness>
    <Thickness x:Key="AvFieldPadding">12,0,6,0</Thickness>
    <!-- Nothing touches the window edge. The visible gap is the whole idea. -->
    <Thickness x:Key="AvChromeMargin">12,8,12,0</Thickness>


    <!-- Monogram chip and loading slug only. Glass rounds one step further, as every surface in Tahoe does.
         StaticResource, so ApplyLookGeometry re-applies it by hand on a swap. -->
    <CornerRadius x:Key="AvMonogramRadius">5</CornerRadius>
    <x:Double x:Key="AvFaviconSize">16</x:Double>
    <x:Double x:Key="AvTileIconSize">44</x:Double>


    <!-- Sidebar geometry. StaticResource, so ApplyLookGeometry re-reads these. -->
    <CornerRadius x:Key="AvSidebarRadius">18</CornerRadius>
    <CornerRadius x:Key="AvSidebarRowRadius">8</CornerRadius>
    <Thickness x:Key="AvSidebarMargin">12,8,0,12</Thickness>
    <x:Double x:Key="AvSidebarRowHeight">30</x:Double>
    <CornerRadius x:Key="AvSegmentRadius">9</CornerRadius>

</ResourceDictionary>
