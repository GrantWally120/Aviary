<!--
    AVIARY — CLASSIC THEME
    Safari 15 to 18: the solid unified toolbar era. One opaque plane welded to the top of
    the window, no gradient, no elevation, and a single hairline.

    This file is one half of a contract. LiquidGlass.xaml declares EXACTLY the same keys
    with different values, so Phase 3 can swap which dictionary App.xaml merges and every
    control follows without being touched. If you add a key here, add it there too.

    Colours are #AARRGGBB. Alpha bytes are rounded from the measured Phase 0 values, e.g.
    rgba(0,0,0,0.16) -> 0.16 * 255 = 41 = 0x29 -> #29000000.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- #EDEDED, not #FFFFFF. Pure white toolbars read as Edge. -->
            <SolidColorBrush x:Key="AvChromeBrush"          Color="#FFEDEDED" />
            <SolidColorBrush x:Key="AvPageBrush"            Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AvHairlineBrush"        Color="#29000000" />

            <SolidColorBrush x:Key="AvLabelBrush"           Color="#D9000000" />
            <SolidColorBrush x:Key="AvLabelSecondaryBrush"  Color="#80000000" />
            <SolidColorBrush x:Key="AvLabelTertiaryBrush"   Color="#52000000" />
            <SolidColorBrush x:Key="AvIconBrush"            Color="#BF000000" />

            <!-- Every interactive fill is an alpha, never a solid hex. Phase 3 tints the
                 whole chrome from the page colour, and a solid grey would read as a bug
                 the moment that happens. -->
            <SolidColorBrush x:Key="AvHoverBrush"           Color="#0F000000" />
            <SolidColorBrush x:Key="AvPressBrush"           Color="#1F000000" />
            <SolidColorBrush x:Key="AvSelectedBrush"        Color="#1A000000" />
            <SolidColorBrush x:Key="AvTabActiveBrush"      Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AvTabHoverBrush"       Color="#0D000000" />

            <SolidColorBrush x:Key="AvFieldBrush"           Color="#0E000000" />
            <SolidColorBrush x:Key="AvFieldBorderBrush"     Color="#0F000000" />
            <SolidColorBrush x:Key="AvFieldFocusBrush"      Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="AvAccentBrush"          Color="#FF007AFF" />
            <SolidColorBrush x:Key="AvSeparatorBrush"       Color="#1A000000" />

            <!-- Classic is flat. These exist only to satisfy the contract. -->
            <SolidColorBrush x:Key="AvEdgeTopBrush"         Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AvEdgeBottomBrush"      Color="#00000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AvChromeBrush"          Color="#FF2E2E2E" />
            <SolidColorBrush x:Key="AvPageBrush"            Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="AvHairlineBrush"        Color="#1FFFFFFF" />

            <SolidColorBrush x:Key="AvLabelBrush"           Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="AvLabelSecondaryBrush"  Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="AvLabelTertiaryBrush"   Color="#57FFFFFF" />
            <SolidColorBrush x:Key="AvIconBrush"            Color="#D9FFFFFF" />

            <SolidColorBrush x:Key="AvHoverBrush"           Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AvPressBrush"           Color="#29FFFFFF" />
            <SolidColorBrush x:Key="AvSelectedBrush"        Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AvTabActiveBrush"      Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AvTabHoverBrush"       Color="#12FFFFFF" />

            <SolidColorBrush x:Key="AvFieldBrush"           Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AvFieldBorderBrush"     Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AvFieldFocusBrush"      Color="#FF2C2C2E" />

            <SolidColorBrush x:Key="AvAccentBrush"          Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AvSeparatorBrush"       Color="#1CFFFFFF" />

            <SolidColorBrush x:Key="AvEdgeTopBrush"         Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AvEdgeBottomBrush"      Color="#00000000" />
        </ResourceDictionary>

        <!-- Required. With only Light and Dark declared, a machine running a Windows
             contrast theme misses every Av* lookup. Values come from the system contrast
             palette rather than invented colours — that is the entire point of the mode,
             and a browser that ignores it is unusable for the people who need it. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AvChromeBrush"          Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvPageBrush"            Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AvHairlineBrush"        Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="AvLabelBrush"           Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvLabelSecondaryBrush"  Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvLabelTertiaryBrush"   Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AvIconBrush"            Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="AvHoverBrush"           Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvPressBrush"           Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSelectedBrush"        Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvTabActiveBrush"      Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvTabHoverBrush"       Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="AvFieldBrush"           Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AvFieldBorderBrush"     Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AvFieldFocusBrush"      Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="AvAccentBrush"          Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AvSeparatorBrush"       Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="AvEdgeTopBrush"         Color="Transparent" />
            <SolidColorBrush x:Key="AvEdgeBottomBrush"      Color="Transparent" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- GEOMETRY. Identical in light and dark, so it sits outside the theme dictionaries.
         Safari's toolbar is 52px; 48 is Windows' "Tall" title-bar height, which makes the
         system caption buttons exactly 46x48 instead of an awkward 46x52. -->
    <x:Double x:Key="AvToolbarHeight">48</x:Double>
    <x:Double x:Key="AvFieldHeight">30</x:Double>
    <x:Double x:Key="AvButtonSize">28</x:Double>
    <x:Double x:Key="AvIconSize">17</x:Double>
    <x:Double x:Key="AvTabHeight">32</x:Double>
    <x:Double x:Key="AvCaptionButtonWidth">46</x:Double>
    <x:Double x:Key="AvGlyphStrokeThickness">1.6</x:Double>

    <!-- 7px. A pill here is Chrome or Edge, and it is the fastest visual tell there is. -->
    <CornerRadius x:Key="AvFieldCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="AvButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="AvTabCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AvChromeCornerRadius">0</CornerRadius>

    <Thickness x:Key="AvToolbarPadding">12,0,0,0</Thickness>
    <Thickness x:Key="AvFieldPadding">4,0,4,0</Thickness>
    <Thickness x:Key="AvChromeMargin">0</Thickness>

</ResourceDictionary>
