<Window
    x:Class="Aviary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Aviary"
    mc:Ignorable="d"
    Title="Aviary">

    <!-- Mica Alt: the darker base Explorer and Terminal use behind a tab strip.
         CURRENTLY INERT. Classic's whole premise is one opaque plane, so AvChromeBrush
         covers it completely and none of it shows. It stays declared because Liquid Glass
         in Phase 3 is translucent and will need it, and because removing and re-adding a
         backdrop is how you end up debugging a black window. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">

        <Grid.Resources>

            <!-- Neutralise the stock TextBox chrome. The default template paints its own
                 background, border and focus underline; the surrounding Border should be
                 the only visible surface, exactly as Safari draws it. -->
            <SolidColorBrush x:Key="TextControlBackground"             Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled"     Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush"            Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled"    Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            <Thickness x:Key="TextControlThemePadding">0</Thickness>

            <!-- A toolbar button. Fluent's default Button carries a visible fill, a border
                 and a 4px radius; all three are wrong here, so this replaces the template
                 outright rather than fighting it with setters. -->
            <Style x:Key="AvToolButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AvIconBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="{StaticResource AvButtonSize}" />
                <Setter Property="Height" Value="{StaticResource AvButtonSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{StaticResource AvButtonCornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource AvHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <!-- macOS toolbar buttons darken. They never scale. -->
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource AvPressBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.32" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The two small buttons that live INSIDE the address field. Reload on the
                 right, "Aa" on the left. Putting reload outside the field, next to
                 back/forward, is the single loudest Chrome tell there is. -->
            <Style x:Key="AvFieldButton" TargetType="Button" BasedOn="{StaticResource AvToolButton}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Foreground" Value="{ThemeResource AvLabelSecondaryBrush}" />
            </Style>

            <!-- A TAB.
                 Safari 15+ tabs are detached rounded rectangles that abut each other inside
                 the strip, and the active one reads as a raised chip rather than a shape
                 connected to the toolbar. A ToggleButton is used rather than a Button
                 purely so "selected" is a visual state the template can express — which
                 keeps every colour in the theme dictionary instead of assigned from code. -->
            <!-- A favourites-bar chip. Safari's are 22px tall with a 5px radius — much
                 smaller than a toolbar button, because the bar is a list, not a control
                 surface. -->
            <Style x:Key="AvBookmarkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AvLabelBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="BmRoot"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}"
                                  CornerRadius="5">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BmRoot.Background" Value="{ThemeResource AvHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="BmRoot.Background" Value="{ThemeResource AvPressBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The error panel's actions. The favourites-bar button's own template (no
                 Fluent accent, our hover and press fills), sized up for a page-sized panel. -->
            <Style x:Key="AvPanelButton" TargetType="Button" BasedOn="{StaticResource AvBookmarkButton}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{ThemeResource AvFieldBrush}" />
            </Style>

            <Style x:Key="AvTabButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AvLabelSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="{StaticResource AvTabHeight}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="TabRoot"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{StaticResource AvTabCornerRadius}"
                                  Padding="8,0,8,0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabRoot.Background" Value="{ThemeResource AvTabHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabRoot.Background" Value="{ThemeResource AvTabHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                        <!-- The active tab: a raised chip. Its shadow is
                                             sub-pixel on purpose; any real blur here and it
                                             stops reading as Safari. -->
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="TabRoot.Background" Value="{ThemeResource AvTabActiveBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource AvLabelBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabRoot.Background" Value="{ThemeResource AvTabActiveBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource AvLabelBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabRoot.Background" Value="{ThemeResource AvTabActiveBrush}" />
                                                <Setter Target="Presenter.Foreground" Value="{ThemeResource AvLabelBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Presenter"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ SITE IDENTITY ══
                 FaviconView draws the 16px cell in tabs, the favourites bar and later the
                 sidebar. Every colour it uses arrives through one of these Styles rather
                 than being looked up in code, because Application.Current.Resources[...]
                 hands back a SNAPSHOT brush that stops following the theme — which is
                 exactly the bug the old hardcoded white monogram letter had. -->

            <Style x:Key="AvFaviconSlugStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AvFaviconPlaceholderBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource AvMonogramRadius}" />
            </Style>

            <Style x:Key="AvMonogramInkStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AvMonogramInkBrush}" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AvMonogramChipStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource AvMonogramBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource AvMonogramRadius}" />
            </Style>

            <!-- The eight hues cannot be one setter, so each gets a one-line Style. Doing
                 it here rather than as a code-side SolidColorBrush is what keeps the
                 ThemeResource live across a light/dark switch. -->
            <Style x:Key="AvMonogramChip1Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram1Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip2Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram2Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip3Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram3Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip4Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram4Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip5Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram5Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip6Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram6Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip7Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram7Brush}" />
            </Style>
            <Style x:Key="AvMonogramChip8Style" TargetType="Border" BasedOn="{StaticResource AvMonogramChipStyle}">
                <Setter Property="Background" Value="{ThemeResource AvMonogram8Brush}" />
            </Style>

            <!-- Aviary's own mark, shown in the tab for Aviary's own pages. Safari puts its
                 compass there, not a letter; showing "S" for Settings is a tell. -->
            <Style x:Key="AvFaviconMarkStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AvAccentBrush}" />
                <Setter Property="StrokeThickness" Value="1.3" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>

            <!-- ══ SIDEBAR CONTROLS ══
                 Both of these replace the Fluent template outright rather than setting
                 properties on it. A stock ToggleButton's Checked state paints the SYSTEM
                 ACCENT from the Fluent theme and overrides any Background assigned in
                 code — so the segmented control came out as an accent-blue Windows
                 toggle, which is the one thing this project cannot look like. -->

            <Style x:Key="AvSegmentButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AvIconBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="SegRoot"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{StaticResource AvSidebarRowRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SegRoot.Background" Value="{ThemeResource AvSidebarRowHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SegRoot.Background" Value="{ThemeResource AvSidebarRowHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                        <!-- Selected is a raised neutral chip, never the
                                             system accent — the same idea as the active tab. -->
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="SegRoot.Background" Value="{ThemeResource AvSegmentSelectedBrush}" />
                                                <Setter Target="SegPresenter.Foreground" Value="{ThemeResource AvLabelBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SegRoot.Background" Value="{ThemeResource AvSegmentSelectedBrush}" />
                                                <Setter Target="SegPresenter.Foreground" Value="{ThemeResource AvLabelBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="SegRoot.Background" Value="{ThemeResource AvSegmentSelectedBrush}" />
                                                <Setter Target="SegPresenter.Foreground" Value="{ThemeResource AvLabelBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="SegPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A 30px list row: bookmark, reading-list item, history entry. -->
            <Style x:Key="AvSidebarRowButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AvLabelBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="{StaticResource AvSidebarRowHeight}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RowRoot"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}"
                                  CornerRadius="{StaticResource AvSidebarRowRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RowRoot.Background" Value="{ThemeResource AvSidebarRowHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RowRoot.Background" Value="{ThemeResource AvSidebarRowSelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The reading-list All / Unread filter. -->
            <Style x:Key="AvFilterButton" TargetType="ToggleButton" BasedOn="{StaticResource AvSegmentButton}">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Foreground" Value="{ThemeResource AvLabelSecondaryBrush}" />
            </Style>

            <!-- The tab's close glyph. Hand-drawn, never an icon font. -->
            <Style x:Key="AvTabGlyphStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AvLabelBrush}" />
                <Setter Property="StrokeThickness" Value="1.35" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — THE TOOLBAR, WHICH IS ALSO THE TITLE BAR ══════════════════
             One opaque plane at y=0, edge to edge, no gap and no rounded top corners of
             its own: the window's 8px Windows radius clips it. 48px is Windows' "Tall"
             title-bar height, which makes the system caption buttons exactly 46x48 —
             the code-behind asks for Tall explicitly, or they render 46x32 top-aligned.

             The bottom hairline is the only structural line in the whole theme. -->
        <Grid x:Name="ToolbarRow"
              Grid.Row="0"
              Height="{StaticResource AvToolbarHeight}"
              Background="{ThemeResource AvChromeBrush}"
              Padding="{StaticResource AvToolbarPadding}">

            <!-- Two equal drag columns flank the address field, so the field sits on the
                 optical centre of the USABLE toolbar — between the left button group and
                 the right group plus the caption inset — rather than being shoved left.
                 They double as the window drag region, which SetTitleBar needs, and
                 splitting it in two means neither half can starve. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="24" />
                <ColumnDefinition Width="6*" MinWidth="240" />
                <ColumnDefinition Width="*" MinWidth="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left group. Sidebar toggle sits 12px from the window edge; back and forward
                 are a coupled pair, hence the tight 2px between them. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SidebarButton" Style="{StaticResource AvToolButton}"
                        IsEnabled="False" ToolTipService.ToolTip="Sidebar (Phase 2)">
                    <Path Width="17" Height="17"
                          Data="M2.6,4 H14.4 A1.6,1.6 0 0 1 16,5.6 V11.4 A1.6,1.6 0 0 1 14.4,13 H2.6 A1.6,1.6 0 0 1 1,11.4 V5.6 A1.6,1.6 0 0 1 2.6,4 Z M6.2,4 V13"
                          Stroke="{ThemeResource AvIconBrush}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round" />
                </Button>
                <Border Width="12" />
                <Button x:Name="BackButton" Style="{StaticResource AvToolButton}"
                        Click="BackButton_Click" ToolTipService.ToolTip="Back">
                    <Path Width="17" Height="17" Data="M10.6,3.8 L6.4,8.5 L10.6,13.2"
                          Stroke="{ThemeResource AvIconBrush}"
                          StrokeThickness="1.9"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Width="2" />
                <Button x:Name="ForwardButton" Style="{StaticResource AvToolButton}"
                        Click="ForwardButton_Click" ToolTipService.ToolTip="Forward">
                    <Path Width="17" Height="17" Data="M6.4,3.8 L10.6,8.5 L6.4,13.2"
                          Stroke="{ThemeResource AvIconBrush}"
                          StrokeThickness="1.9"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Width="10" />

                <!-- Shields (Phase 5 M3) — where Safari keeps its Privacy Report button. The count
                     is what was blocked on this page; a slash means Shields are down for this
                     site. Existing tokens only: a new key would have to go into all six
                     dictionaries (the theme contract, HANDOFF §6). -->
                <Button x:Name="ShieldsButton" Style="{StaticResource AvToolButton}"
                        AutomationProperties.Name="Shields"
                        Click="ShieldsButton_Click" ToolTipService.ToolTip="Shields">
                    <Grid>
                        <Path x:Name="ShieldGlyph" Width="17" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M8.5,1.9 L3.3,4 V8 C3.3,11.1 5.4,13.8 8.5,14.8 C11.6,13.8 13.7,11.1 13.7,8 V4 Z"
                              Stroke="{ThemeResource AvIconBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                        <Path x:Name="ShieldSlash" Width="17" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"
                              Data="M2.6,14.4 L14.4,2.6"
                              Stroke="{ThemeResource AvIconBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Border x:Name="ShieldCount"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-5,-3"
                                Padding="2,0,2,0"
                                MinWidth="11"
                                CornerRadius="4"
                                Background="{ThemeResource AvChromeBrush}">
                            <TextBlock x:Name="ShieldCountText"
                                       FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AvAccentBrush}" />
                        </Border>
                    </Grid>
                </Button>
                <Border Width="12" />

                <!-- Only in a private window: say so, where the eye already is. -->
                <Border x:Name="PrivateBadge"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Height="24"
                        Padding="8,0,10,0"
                        Margin="0,0,12,0"
                        CornerRadius="7"
                        Background="{ThemeResource AvFieldBrush}"
                        BorderBrush="{ThemeResource AvFieldBorderBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Private window: nothing you do here is remembered after you close it.">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Width="15" Height="15"
                              Data="M1.8,7.5 C3.6,4.6 5.6,3.4 7.5,3.4 C9.4,3.4 11.4,4.6 13.2,7.5 C11.4,10.4 9.4,11.6 7.5,11.6 C5.6,11.6 3.6,10.4 1.8,7.5 Z M2.4,12.9 L12.6,2.1"
                              Stroke="{ThemeResource AvIconBrush}"
                              StrokeThickness="1.3"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Private" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource AvLabelBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══ THE ADDRESS FIELD ══
                 30px tall, 7px radius. Not a pill — Chrome and Edge use pills, Safari uses
                 a rounded rectangle, and that is the fastest tell after reload's position.

                 Rest and focus are two stacked Borders whose opacity is crossfaded, rather
                 than a colour assigned from code. That keeps every colour in the theme
                 dictionary where requirement 3 says it belongs. -->
            <Grid x:Name="AddressField"
                  Grid.Column="2"
                  Height="{StaticResource AvFieldHeight}"
                  VerticalAlignment="Center">

                <Border x:Name="FieldRest"
                        CornerRadius="{StaticResource AvFieldCornerRadius}"
                        Background="{ThemeResource AvFieldBrush}"
                        BorderBrush="{ThemeResource AvFieldBorderBrush}"
                        BorderThickness="1" />

                <Border x:Name="FieldFocus"
                        Opacity="0"
                        CornerRadius="{StaticResource AvFieldCornerRadius}"
                        Background="{ThemeResource AvFieldFocusBrush}"
                        BorderBrush="{ThemeResource AvAccentBrush}"
                        BorderThickness="1" />

                <!-- Safari's page-loading progress: a thin line along the bottom of the field that
                     runs out while a page loads and finishes when it has (M4.5, ChromeMotion.cs).
                     WebView2 reports no percentage, so like Safari's it eases toward three
                     quarters and completes on the page's own finish. -->
                <Border x:Name="LoadLine"
                        Height="2" Margin="10,0,10,1" CornerRadius="1"
                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        IsHitTestVisible="False" Opacity="0"
                        Background="{ThemeResource AvAccentBrush}" />

                <Grid Padding="{StaticResource AvFieldPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- "Aa" — page settings. Inert until Phase 4. -->
                    <Button x:Name="PageSettingsButton" Grid.Column="0"
                            Style="{StaticResource AvFieldButton}"
                            IsEnabled="False" ToolTipService.ToolTip="Page settings (Phase 4)">
                        <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AvLabelSecondaryBrush}" />
                    </Button>

                    <Path x:Name="LockGlyph" Grid.Column="1"
                          Width="12" Height="12" Margin="6,0,0,0"
                          VerticalAlignment="Center"
                          Data="M3.2,5.6 H8.8 A1.2,1.2 0 0 1 10,6.8 V9.6 A1.2,1.2 0 0 1 8.8,10.8 H3.2 A1.2,1.2 0 0 1 2,9.6 V6.8 A1.2,1.2 0 0 1 3.2,5.6 Z M4.2,5.6 V4.2 A1.8,1.8 0 0 1 7.8,4.2 V5.6"
                          Stroke="{ThemeResource AvLabelSecondaryBrush}"
                          StrokeThickness="1.2"
                          StrokeLineJoin="Round"
                          Visibility="Collapsed" />

                    <!-- Centred and domain-only when idle; full URL, left-aligned and
                         selected, on focus. The alignment switch is instantaneous —
                         animating it reads as a web-page effect, which this is not. -->
                    <TextBox x:Name="AddressBox"
                             Grid.Column="2"
                             Margin="6,0,6,0"
                             VerticalAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="0"
                             FontSize="13"
                             TextAlignment="Center"
                             Foreground="{ThemeResource AvLabelBrush}"
                             PlaceholderText="Search or enter website name"
                             PlaceholderForeground="{ThemeResource AvLabelTertiaryBrush}"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap"
                             GotFocus="AddressBox_GotFocus"
                             LostFocus="AddressBox_LostFocus"
                             TextChanged="AddressBox_TextChanged"
                             KeyDown="AddressBox_KeyDown" />

                    <Button x:Name="ReloadButton" Grid.Column="3"
                            Style="{StaticResource AvFieldButton}"
                            Click="ReloadButton_Click" ToolTipService.ToolTip="Reload">
                        <Path x:Name="ReloadGlyph" Width="13" Height="13"
                              Data="M11.9,6.5 A4.4,4.4 0 1 1 10.5,3.3 M11.6,1.4 V4.6 H8.4"
                              Stroke="{ThemeResource AvLabelSecondaryBrush}"
                              StrokeThickness="1.4"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Grid>

            <!-- The window drag region. Deliberately its own empty column with a minimum
                 width: a drag region containing no interactive children behaves correctly
                 on every Windows App SDK version. -->
            <Border x:Name="DragRegion" Grid.Column="1" Background="Transparent" />
            <Border x:Name="DragRegionRight" Grid.Column="3" Background="Transparent" />

            <!-- Right group. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="HomeButton" Style="{StaticResource AvToolButton}"
                        Click="HomeButton_Click" ToolTipService.ToolTip="Home">
                    <Path Width="17" Height="17"
                          Data="M2.8,8.2 L8.5,3.2 L14.2,8.2 M4.5,7 V13.5 H12.5 V7"
                          Stroke="{ThemeResource AvIconBrush}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Width="4" />
                <Button x:Name="DownloadsButton" Style="{StaticResource AvToolButton}"
                        Visibility="Collapsed"
                        Click="DownloadsButton_Click" ToolTipService.ToolTip="Downloads">
                    <Path Width="17" Height="17"
                          Data="M8.5,2.8 V10.4 M5.6,7.8 L8.5,10.7 L11.4,7.8 M3.4,12.4 v0.6 a1.4,1.4 0 0 0 1.4,1.4 h7.4 a1.4,1.4 0 0 0 1.4,-1.4 v-0.6"
                          Stroke="{ThemeResource AvIconBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Width="4" />
                <Button x:Name="MenuButton" Style="{StaticResource AvToolButton}"
                        Click="MenuButton_Click" ToolTipService.ToolTip="Menu">
                    <Path Width="17" Height="17"
                          Data="M2.8,5 H14.2 M2.8,8.5 H14.2 M2.8,12 H14.2"
                          Stroke="{ThemeResource AvIconBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Width="8" />
            </StackPanel>

            <!-- Reserved for the system caption buttons. Width comes from
                 AppWindowTitleBar.RightInset in code-behind — hardcoding 138px is wrong the
                 moment the display is at 150%, where the real inset is 207 device pixels. -->
            <Border x:Name="CaptionSpacer" Grid.Column="5" Width="141" />
        </Grid>


        <!-- ══ ROW 1 — THE TAB STRIP ═══════════════════════════════════════════
             Safari puts tabs BELOW the toolbar, not above it. The columns are rebuilt in
             code so tabs divide the full strip width the way Safari's do — capping them at
             a fixed width gives you a Chrome silhouette with Apple paint on it.

             This row carries the single hairline, because it is the bottom-most piece of
             chrome. -->
        <Grid x:Name="TabStripRow"
              Grid.Row="1"
              Height="40"
              Background="{ThemeResource AvChromeBrush}"
              BorderBrush="{ThemeResource AvHairlineBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The active tab's chip, drawn ONCE behind the strip rather than by each tab, so
                 it can travel from tab to tab: gliding under Smooth Flight, stretching like gel
                 under Fluid (MainWindow.TabMotion.cs, M4.5). Before the strip, so the tabs'
                 titles draw over it. -->
            <Border x:Name="TabPillHost" Grid.Column="0" IsHitTestVisible="False" />

            <Grid x:Name="TabStrip" Grid.Column="0" />

            <Button x:Name="NewTabButton" Grid.Column="1"
                    Style="{StaticResource AvToolButton}"
                    Margin="4,0,0,0"
                    Click="NewTabButton_Click"
                    ToolTipService.ToolTip="New tab (Ctrl+T)">
                <Path Width="17" Height="17" Data="M8.5,3.6 V13.4 M3.6,8.5 H13.4"
                      Stroke="{ThemeResource AvIconBrush}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </Grid>



        <!-- ══ ROW 2 — THE FAVOURITES BAR ══════════════════════════════════════
             Safari's is 32px with 22px items. Hidden unless you turn it on, because an
             empty strip of chrome is worse than no strip at all. -->
        <Grid x:Name="BookmarksBar"
              Grid.Row="2"
              Height="32"
              Visibility="Collapsed"
              Background="{ThemeResource AvChromeBrush}"
              BorderBrush="{ThemeResource AvHairlineBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,0,8,0">
            <!-- Behind the strip, in the same cell: what an empty favourites bar says for
                 itself. Without it, switching the bar on with nothing saved shows a blank
                 band of chrome and reads as a bug. -->
            <TextBlock x:Name="BookmarksEmptyHint"
                       Text="Add a site with Ctrl+D"
                       FontSize="12"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource AvLabelTertiaryBrush}" />

            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Disabled">
                <StackPanel x:Name="BookmarksStrip" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center" />
            </ScrollViewer>
        </Grid>

        <!-- ══ ROW 3 — FIND IN PAGE ════════════════════════════════════════════
             Safari's find bar is a strip below the chrome, not a floating box. It only
             takes up space when it is open, so the row is Auto-height and collapsed. -->
        <Grid x:Name="FindBar"
              Grid.Row="3"
              Height="40"
              Visibility="Collapsed"
              Background="{ThemeResource AvChromeBrush}"
              BorderBrush="{ThemeResource AvHairlineBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,0,8,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Find" VerticalAlignment="Center"
                       FontSize="13" Foreground="{ThemeResource AvLabelSecondaryBrush}" />

            <Border Grid.Column="1"
                    Height="{StaticResource AvFieldHeight}"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource AvFieldCornerRadius}"
                    Background="{ThemeResource AvFieldBrush}"
                    BorderBrush="{ThemeResource AvFieldBorderBrush}"
                    BorderThickness="1"
                    Padding="10,0">
                <TextBox x:Name="FindBox"
                         VerticalAlignment="Center"
                         Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                         FontSize="13"
                         Foreground="{ThemeResource AvLabelBrush}"
                         PlaceholderText="Search this page"
                         PlaceholderForeground="{ThemeResource AvLabelTertiaryBrush}"
                         AcceptsReturn="False" TextWrapping="NoWrap"
                         TextChanged="FindBox_TextChanged"
                         KeyDown="FindBox_KeyDown" />
            </Border>

            <TextBlock x:Name="FindCount" Grid.Column="2" VerticalAlignment="Center"
                       FontSize="12.5" Foreground="{ThemeResource AvLabelSecondaryBrush}"
                       Text="" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="FindPrev" Style="{StaticResource AvToolButton}"
                        Click="FindPrev_Click" ToolTipService.ToolTip="Previous (Shift+Enter)">
                    <Path Width="17" Height="17" Data="M4.4,10.6 L8.5,6.4 L12.6,10.6"
                          Stroke="{ThemeResource AvIconBrush}" StrokeThickness="1.7"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="FindNext" Style="{StaticResource AvToolButton}"
                        Click="FindNext_Click" ToolTipService.ToolTip="Next (Enter)">
                    <Path Width="17" Height="17" Data="M4.4,6.4 L8.5,10.6 L12.6,6.4"
                          Stroke="{ThemeResource AvIconBrush}" StrokeThickness="1.7"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Border Width="6" />
                <Button x:Name="FindClose" Style="{StaticResource AvToolButton}"
                        Click="FindClose_Click" ToolTipService.ToolTip="Done (Esc)">
                    <Path Width="17" Height="17" Data="M4.8,4.8 L12.2,12.2 M12.2,4.8 L4.8,12.2"
                          Stroke="{ThemeResource AvIconBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ ROW 4 — THE SIDEBAR AND THE WEB ═════════════════════════════════
             The sidebar lives HERE and nowhere else. Putting it in the content row rather
             than making it a full-height column of the window means the extended title
             bar, SetTitleBar(DragRegion) and the caption spacer are never touched — which
             removes almost all of the risk in this area.

             One surface, four panes, exactly as Safari's sidebar switches between
             Bookmarks / Reading List / Tab Groups. When the tab layout is Sidebar, the
             horizontal strip collapses and the tab list becomes the Tabs pane, which is
             precisely how Safari does vertical tabs. -->
        <Grid x:Name="ContentRow" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Width is animated as a double. GridLength is NOT animatable in WinUI —
                 there is no GridLengthAnimation — so the column is Auto and the panel
                 owns the number. -->
            <Border x:Name="SidebarRoot"
                    Grid.Column="0"
                    Width="250"
                    Visibility="Collapsed"
                    Background="{ThemeResource AvSidebarBrush}"
                    BorderBrush="{ThemeResource AvSidebarBorderBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="{StaticResource AvSidebarRadius}"
                    Margin="{StaticResource AvSidebarMargin}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The four-segment switcher. Icon-only, so each segment carries an
                         AutomationProperties.Name or a screen reader sees nothing. -->
                    <Border x:Name="SegmentBar"
                            Grid.Row="0"
                            Height="28"
                            Margin="8,10,8,8"
                            Background="{ThemeResource AvSegmentBrush}"
                            CornerRadius="{StaticResource AvSegmentRadius}">
                        <Grid x:Name="SegmentStrip">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="SidebarScroll"
                                  Grid.Row="1"
                                  Padding="8,0,8,12"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarBody" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Drag to resize, 180-420px, double-click back to 250. -->
            <local:SidebarGrip x:Name="SidebarGripBar"
                               Grid.Column="1"
                               Width="6"
                               Visibility="Collapsed"
                               Background="{ThemeResource AvSidebarGripBrush}" />

            <Grid x:Name="ContentHost" Grid.Column="2" Background="{ThemeResource AvPageBrush}">

            <!-- Shown when WebView2 cannot start, or when a process dies. Better a sentence
                 the owner can read than a silent blank window. -->
            <StackPanel x:Name="ErrorPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="440"
                        Spacing="10">
                <TextBlock x:Name="ErrorTitle"
                           Text="This page didn't load"
                           FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AvLabelBrush}" />
                <TextBlock x:Name="ErrorDetail"
                           Text=""
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{ThemeResource AvLabelSecondaryBrush}" />

                <!-- Only for the HTTPS-Only fallback: Go Back (the safe choice, first) and
                     Continue to Site (remembered for that site). -->
                <StackPanel x:Name="ErrorActions"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="ErrorBackButton" Style="{StaticResource AvPanelButton}"
                            Content="Go Back" Click="ErrorBack_Click" />
                    <Button x:Name="ErrorContinueButton" Style="{StaticResource AvPanelButton}"
                            Content="Continue to Site" Click="ErrorContinue_Click" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </Grid>

        <!-- "Press F11 to exit full screen" — shown for a few seconds on entering full
             screen, over everything, never taking a click. Existing tokens only: the theme
             contract says a new key would have to be added to all six dictionaries. -->
        <Border x:Name="FullScreenHint"
                Grid.Row="0" Grid.RowSpan="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Padding="16,9,16,9"
                CornerRadius="10"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="{ThemeResource AvChromeBrush}"
                BorderBrush="{ThemeResource AvHairlineBrush}"
                BorderThickness="1">
            <TextBlock x:Name="FullScreenHintText"
                       Text="Press F11 to exit full screen"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AvLabelBrush}" />
        </Border>

    </Grid>
</Window>
