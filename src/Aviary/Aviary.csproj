<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Explorer and assembly metadata use the same version as Settings and Updates. -->
    <AviaryVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\BuildInfo.cs')), '(?&lt;=public const string Version = &quot;)[0-9]+\.[0-9]+\.[0-9]+').Value)</AviaryVersion>
    <Version>$(AviaryVersion)</Version>

    <!-- net9.0-windows10.0.19041.0 is the TFM the WinUI 3 templates use. The minimum
         platform version stays at 17763 so the app still starts on older Windows 10,
         even though we only care about Windows 11. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <RootNamespace>Aviary</RootNamespace>
    <AssemblyName>Aviary</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- x64 only, on purpose. SelfContained needs a RID, and declaring platforms the
         project cannot actually produce just gives the solution four configurations that
         fail. Widen this and RuntimeIdentifiers together, or not at all. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>

    <!-- Unpackaged: a plain double-clickable .exe with no MSIX identity. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Required even though we ship unpackaged. Without it, WindowsAppSDK's
         MrtCore.PriGen.targets tries to load ExpandPriContent from Visual Studio's
         AppxPackage folder, which a bare .NET SDK does not have, and the build dies with
         MSB4062. This is the documented workaround for building WinUI 3 from the CLI.
         Safe here only because PublishSingleFile is false — the two together trip a
         separate build-time validator. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Both runtimes travel with the app, so the user installs nothing first.
         SelfContained carries .NET 9; WindowsAppSDKSelfContained carries WinUI. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Explicit rather than inherited. Single-file pulls in a build-time validator that
         errors unless several other properties are set, and trimming destroys the
         reflection WinUI's XAML relies on. Both stay off. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- The XAML compiler generates the x:Name fields into MainWindow.g.i.cs without
         initialising them, which trips CS8618 under Nullable=enable. They are warnings on
         generated code, not defects in ours. Never pair this with
         TreatWarningsAsErrors — that turns them into a hard build failure. -->
    <NoWarn>$(NoWarn);CS8618</NoWarn>

    <!-- Main is Aviary's own (Program.cs), not the XAML compiler's: it has to turn a second
         launch away before anything writes the profile (Phase 5 M2, bug 51). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Alpha Build 5 M4.6: the icon, at last (Grant: "it just pops up as that a square with
         blue middle"). Drawn by tools\icon\build-icon.ps1 - change a number there and run it
         rather than editing the .ico. This one is baked into the exe, so it is what Explorer and
         the taskbar shortcut show; Settings -> Accessibility -> App Icon switches the RUNNING
         window between this and the glass one through AppWindow.SetIcon. -->
    <ApplicationIcon>Assets\Aviary.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Both icons travel with the build: the glass one is only reachable at runtime. -->
    <Content Include="Assets\Aviary.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Aviary-Glass.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- M7 "Super Quik": Quik's loading screen, Grant's video (a work in progress - replace the file to
         change it). Played once, muted, the first time Aviary runs Quik (MainWindow.QuikIntro.cs). -->
    <Content Include="Assets\Quik\loading.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK 2.5.1, referenced as the four component packages Aviary uses, not the
         Microsoft.WindowsAppSDK meta-package (23 Oct 2026, docs/SDK-2.5-MIGRATION-2026-10-23.md).
         The meta-package also pulls in the AI, ML, Widgets, Search and DWrite components and the
         native files that go with them (about 70 more files, none used by a browser shell); these
         four are what WinUI windows, Win2D and the unpackaged self-contained start-up need. The
         exact versions are the ones Microsoft.WindowsAppSDK 2.5.1 itself resolves. packages.lock.json
         fixes the graph; release scripts and CI restore in locked mode. Do not refresh it implicitly.

         Microsoft.Windows.SDK.BuildTools is deliberately NOT referenced here: it arrives
         transitively at the version these packages were validated against, and pinning it ahead
         of that buys nothing while risking a MakePri/MakeAppx tooling mismatch. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="[2.3.9]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="[2.3.12]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="[2.1.9]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="[2.0.4]" />

    <!-- Win2D, for Liquid Glass (Grant said yes, 14 Sep 2026 - the NuGet ask in HANDOFF section 2).
         It draws each glass capsule's three-layer shadow cut away under the glass, the way a
         CSS box-shadow is (a composition DropShadow darkens a translucent capsule from below).
         Pinned EXACTLY. 1.4.0 is the Win2D built for the split WinUI packages above (it asks for
         Microsoft.WindowsAppSDK.WinUI 1.8 or later); 1.3.2 belonged to Windows App SDK 1.7. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <!-- Theme dictionaries under Themes\ are picked up by the WinUI SDK's own glob; no
       explicit Page items needed, and adding them by hand only risks a path mismatch. -->

  <!-- The Collection (Library.cs): the page, its catalog and landing pages are source; files\,
       thumbs\ and builds\ are copies of Grant's own projects made by tools\library\sync.ps1 and
       kept out of git. Everything under Library\ travels beside Aviary.exe. None, not Content:
       Content items are fed to the WinUI resource indexer, which has no business with a 38 MB
       WebAssembly engine or a file called "Game Ledger.html". -->
  <ItemGroup>
    <None Update="Library\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludePrivateCollection)' == 'false'">
    <None Remove="Library\files\**\*;Library\thumbs\**\*;Library\builds\**\*" />
  </ItemGroup>
  <Target Name="WarnWithoutLibraryFiles" BeforeTargets="Build" Condition="'$(IncludePrivateCollection)' != 'false' And !Exists('Library\files')">
    <Warning Text="Library\files is missing, so the Collection will list exhibits it cannot open. Run tools\library\sync.ps1 first (it copies Grant's projects in from Documents)." />
  </Target>
  <Target Name="ValidateAviaryVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AviaryVersion)' == ''" Text="BuildInfo.Version must contain a three-part version." />
  </Target>

  <!-- The ad blocker's filter lists (FilterLists.cs, M3): EasyList and EasyPrivacy exactly as
       easylist.to publishes them, with their licence note. Data beside Aviary.exe, never
       compiled in and never edited — None for the same reason as the Library above. -->
  <ItemGroup>
    <None Update="Filters\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
