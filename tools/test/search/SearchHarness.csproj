<Project Sdk="Microsoft.NET.Sdk">
  <!-- Search engines and their suggestions, tested on their own (M4, 14 Sep 2026): compiles
       Aviary's own SearchEngines.cs and SearchSuggestions.cs, so what passes here is the code that
       ships. Offline checks first, then one real request to every engine that suggests, through
       the same client the app uses. Run:  dotnet run -c Release   (from this folder).
       Add  offline  to skip the network. See HANDOFF section 18. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aviary</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\src\Aviary\SearchEngines.cs" Link="Search\SearchEngines.cs" />
    <Compile Include="..\..\..\src\Aviary\SearchSuggestions.cs" Link="Search\SearchSuggestions.cs" />
  </ItemGroup>
</Project>
