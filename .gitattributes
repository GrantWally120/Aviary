# Normalise line endings so the GitHub Actions runner and a Windows checkout agree.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.xaml    text
*.manifest text
*.yml     text eol=lf
*.md      text
*.html    text

# The filter lists ship byte-for-byte as easylist.to publishes them (LF endings): never
# normalised, so the copy in git is the unmodified file its licence note says it is.
src/Aviary/Filters/*.txt -text
src/Aviary/Filters/README.txt text
